# Names only. Real values go in Vercel → Project → Settings → Environment Variables (Production + Preview)
# and, for `vercel dev` on a laptop, in a local .env (gitignored). Never commit values.
OPENAI_API_KEY=
# optional overrides
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_AGENTS_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_MODEL_TRANSPARENT=gpt-image-1.5
# live poll store: added automatically by Vercel Marketplace → Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=
# extra allowed origins for the API (custom domains), comma separated
DECK_ORIGINS=
